#: messaging/apps.py:7 messaging/templates/messaging/log.html:6
msgid "Text messages"
msgstr "Mensajes de texto"

#: messaging/compose.py:31
msgid "unknown"
msgstr "desconocido"

#: messaging/compose.py:37
msgid "light"
msgstr "ligero"

#: messaging/compose.py:38
msgid "moderate"
msgstr "moderado"

#: messaging/compose.py:39
msgid "heavy"
msgstr "pesado"

#: messaging/compose.py:40
msgid "very heavy"
msgstr "muy pesado"

#: messaging/compose.py:62
#, python-format
msgid "%(time)s stop"
msgstr "%(time)s parar"

#: messaging/compose.py:64
#, python-format
msgid "%(time)s %(minutes)s min"
msgstr "%(time)s %(minutes)s min"

#: messaging/compose.py:67
#, python-format
msgid "(+%(count)s more)"
msgstr "(+%(count)s más)"

#: messaging/compose.py:80
#, python-format
msgid ""
"Shadebreak - %(site)s, %(day)s: heat %(risk)s (peak %(wbgt)s°F WBGT at "
"%(time)s)."
msgstr ""
"Shadebreak - %(site)s, %(day)s: calor %(risk)s (máximo %(wbgt)s°F WBGT a las"
" %(time)s)."

#: messaging/compose.py:91
#, python-format
msgid "Rest in shade: %(breaks)s."
msgstr "Descansos a la sombra: %(breaks)s."

#: messaging/compose.py:92
msgid "Drink 1 cup of water every 15-20 min, even if not thirsty."
msgstr "Tome 1 vaso de agua cada 15-20 min, aunque no tenga sed."

#: messaging/compose.py:100
#, python-format
msgid ""
"You are on day %(day)s of %(days)s of your heat ramp: work in the heat until"
" %(time)s, then shade or cool tasks."
msgstr ""
"Hoy es su día %(day)s de %(days)s de aclimatación: trabaje en el calor hasta"
" las %(time)s y después sombra o tareas frescas."

#: messaging/compose.py:110
msgid "First week on the crew: tell your lead right away if you feel sick."
msgstr ""
"Primera semana en la cuadrilla: avise a su jefe de inmediato si se siente "
"mal."

#: messaging/compose.py:113
#, python-format
msgid ""
"Shadebreak - %(site)s, %(day)s: heat %(risk)s. Keep water and shade close."
msgstr ""
"Shadebreak - %(site)s, %(day)s: calor %(risk)s. Tenga agua y sombra cerca."

#: messaging/compose.py:117
#, python-format
msgid "Your buddy: %(name)s."
msgstr "Su compañero: %(name)s."

#: messaging/compose.py:118
#, python-format
msgid "Emergency: call %(number)s."
msgstr "Emergencia: llame al %(number)s."

#: messaging/compose.py:119
msgid "Reply STOP to end texts."
msgstr "Responda STOP para no recibir más mensajes."

#: messaging/compose.py:128
#, python-format
msgid "Shadebreak %(day)s - %(site)s: no forecast yet. Open the app to check."
msgstr ""
"Shadebreak %(day)s - %(site)s: todavía no hay pronóstico. Abra la app para "
"revisar."

#: messaging/compose.py:134
#, python-format
msgid ""
"Shadebreak %(day)s - %(site)s: heat %(risk)s, peak %(wbgt)s°F WBGT / heat "
"index %(hi)s°F at %(time)s."
msgstr ""
"Shadebreak %(day)s - %(site)s: calor %(risk)s, máximo %(wbgt)s°F WBGT / "
"índice de calor %(hi)s°F a las %(time)s."

#: messaging/compose.py:148
#, python-format
msgid "Crew breaks: %(breaks)s."
msgstr "Descansos de la cuadrilla: %(breaks)s."

#: messaging/compose.py:156
#, python-format
msgid "%(name)s (day %(day)s, until %(time)s)"
msgstr "%(name)s (día %(day)s, hasta las %(time)s)"

#: messaging/compose.py:165
#, python-format
msgid "New or ramping up: %(names)s."
msgstr "Nuevos o en aclimatación: %(names)s."

#: messaging/compose.py:168
#, python-format
msgid "Buddies: %(pairs)s."
msgstr "Compañeros: %(pairs)s."

#: messaging/compose.py:192
#, python-format
msgid ""
"Shadebreak: too hot for %(workload)s work until %(time)s. Stop or switch to "
"light tasks in the shade. Drink water."
msgstr ""
"Shadebreak: hace demasiado calor para trabajo %(workload)s hasta las "
"%(time)s. Pare o cambie a tareas ligeras a la sombra. Tome agua."

#: messaging/compose.py:195
#, python-format
msgid ""
"Shadebreak: rest break now, %(minutes)s min in the shade until %(time)s. "
"Drink water."
msgstr ""
"Shadebreak: descanso ahora, %(minutes)s min a la sombra hasta las %(time)s. "
"Tome agua."

#: messaging/compose.py:203
#, python-format
msgid ""
"Shadebreak: water check. Drink a cup now, even if you are not thirsty. Heat:"
" %(risk)s."
msgstr ""
"Shadebreak: hora de tomar agua. Tome un vaso ahora, aunque no tenga sed. "
"Calor: %(risk)s."

#: messaging/compose.py:218
#, python-format
msgid ""
"Shadebreak check-in: %(worker)s has no buddy on site. Check on them now. "
"Reply 1 if OK, 2 if they need help."
msgstr ""
"Shadebreak revisión: %(worker)s no tiene compañero en la obra. Revise cómo "
"está ahora. Responda 1 si está bien, 2 si necesita ayuda."

#: messaging/compose.py:223
#, python-format
#| msgid ""
#| "Shadebreak check-in: look at %(worker)s now. Reply 1 if OK, 2 if they need "
#| "help. Danger signs: confusion, slurred speech, fainting, hot dry skin - call"
#| " %(number)s."
msgid ""
"Shadebreak check-in: look at %(workers)s now. Reply 1 if all are OK, 2 if "
"anyone needs help. Danger signs: confusion, slurred speech, fainting, hot "
"dry skin - call %(number)s."
msgstr ""
"Shadebreak revisión: revise cómo están %(workers)s ahora. Responda 1 si "
"todos están bien, 2 si alguien necesita ayuda. Señales de peligro: "
"confusión, habla arrastrada, desmayo, piel caliente y seca - llame al "
"%(number)s."

#: messaging/compose.py:228
#, python-format
msgid ""
"Shadebreak check-in: look at %(worker)s now. Reply 1 if OK, 2 if they need "
"help. Danger signs: confusion, slurred speech, fainting, hot dry skin - call"
" %(number)s."
msgstr ""
"Shadebreak revisión: revise cómo está %(worker)s ahora. Responda 1 si está "
"bien, 2 si necesita ayuda. Señales de peligro: confusión, habla arrastrada, "
"desmayo, piel caliente y seca - llame al %(number)s."

#: messaging/compose.py:236
#, python-format
#| msgid "%(name)s (day %(day)s, until %(time)s)"
msgid "%(names)s and %(last)s"
msgstr "%(names)s y %(last)s"

#: messaging/compose.py:242
msgid "you"
msgstr "usted"

#: messaging/compose.py:244
#, python-format
msgid ""
"Shadebreak ALERT: no reply to the %(time)s check-in on %(worker)s at "
"%(site)s (asked: %(buddy)s). Check on %(worker)s now."
msgstr ""
"Shadebreak ALERTA: nadie respondió la revisión de las %(time)s sobre "
"%(worker)s en %(site)s (se le preguntó a: %(buddy)s). Revise a %(worker)s "
"ahora."

#: messaging/compose.py:259
#, python-format
msgid ""
"Shadebreak URGENT: %(worker)s texted for help at %(site)s. Call them now: "
"%(phone)s. If confused, fainting or not sweating: call %(number)s."
msgstr ""
"Shadebreak URGENTE: %(worker)s pidió ayuda por mensaje en %(site)s. Llámele "
"ahora: %(phone)s. Si hay confusión, desmayo o no suda: llame al %(number)s."

#: messaging/compose.py:268
#, python-format
msgid ""
"Shadebreak URGENT: %(reporter)s says %(worker)s needs help at %(site)s. Go "
"now. If confused, fainting or not sweating: call %(number)s and cool them "
"with cold water or ice."
msgstr ""
"Shadebreak URGENTE: %(reporter)s dice que %(worker)s necesita ayuda en "
"%(site)s. Vaya ahora. Si hay confusión, desmayo o no suda: llame al "
"%(number)s y enfríe a la persona con agua fría o hielo."

#: messaging/compose.py:275
#, python-format
msgid "Shadebreak update: %(reporter)s says %(worker)s is OK."
msgstr "Shadebreak aviso: %(reporter)s dice que %(worker)s está bien."

#: messaging/compose.py:276
msgid "Someone"
msgstr "Alguien"

#: messaging/compose.py:283
#, python-format
msgid "Thanks. Logged: %(names)s OK."
msgstr "Gracias. Anotado: %(names)s bien."

#: messaging/compose.py:289
#, python-format
msgid ""
"Alert sent to your crew lead. Stay with %(names)s, get to shade and cool off"
" with water. Call %(number)s for confusion, fainting or vomiting."
msgstr ""
"Se avisó a su jefe de cuadrilla. Quédese con %(names)s, vayan a la sombra y "
"refrésquense con agua. Llame al %(number)s si hay confusión, desmayo o "
"vómito."

#: messaging/compose.py:297
#, python-format
msgid ""
"Alert sent to your crew lead. Stop work, get to shade and drink water. If "
"you feel confused or faint, call %(number)s."
msgstr ""
"Se avisó a su jefe de cuadrilla. Pare de trabajar, vaya a la sombra y tome "
"agua. Si se siente confundido o mareado, llame al %(number)s."

#: messaging/compose.py:304
msgid ""
"Shadebreak: you will not get more texts. Reply START to turn them back on."
msgstr ""
"Shadebreak: ya no recibirá mensajes. Responda START para volver a "
"recibirlos."

#: messaging/compose.py:309
msgid "Shadebreak: texts are on. Reply STOP to turn them off."
msgstr ""
"Shadebreak: los mensajes están activados. Responda STOP para desactivarlos."

#: messaging/compose.py:315
#, python-format
msgid ""
"Shadebreak heat-safety texts. Reply 1 = OK, 2 = needs help, STOP = end "
"texts. Emergency: call %(number)s."
msgstr ""
"Mensajes de seguridad contra el calor de Shadebreak. Responda 1 = bien, 2 = "
"necesita ayuda, STOP = no más mensajes. Emergencia: llame al %(number)s."

