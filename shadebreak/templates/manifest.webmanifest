{% load static %}{
  "name": "Shadebreak",
  "short_name": "Shadebreak",
  "description": "Heat-illness prevention for outdoor crews",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#faf6ef",
  "theme_color": "#1d2633",
  "icons": [
    {"src": "{% static 'shadebreak/img/icon-192.png' %}", "sizes": "192x192", "type": "image/png"},
    {"src": "{% static 'shadebreak/img/icon-512.png' %}", "sizes": "512x512", "type": "image/png"},
    {"src": "{% static 'shadebreak/img/logo.svg' %}", "sizes": "any", "type": "image/svg+xml"}
  ]
}
