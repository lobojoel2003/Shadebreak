# Copy to .env and fill in. Every setting is optional unless marked REQUIRED.

# --- Django -----------------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=shadebreak.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shadebreak.example.com
# Behind a TLS-terminating proxy (Caddy, nginx, a PaaS router):
DJANGO_BEHIND_PROXY=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_PRELOAD=1   # only once you are sure every subdomain serves HTTPS
# DJANGO_DEBUG=1          # development only
# DATABASE_URL=postgres://user:pass@host:5432/shadebreak   (docker compose sets this)
# CELERY_BROKER_URL=redis://host:6379/0                     (docker compose sets this)
POSTGRES_PASSWORD=change-me

# --- Shadebreak ---------------------------------------------------------------
# The National Weather Service asks for an app name and a way to reach you.
SHADEBREAK_NWS_USER_AGENT=Shadebreak (ops@example.com)
# Public base URL, used to verify Twilio webhook signatures behind proxies.
SHADEBREAK_PUBLIC_URL=https://shadebreak.example.com
SHADEBREAK_ALLOW_SIGNUP=1
# Days away from hot work before the returning-worker ramp starts again.
SHADEBREAK_ACCLIMATIZATION_GAP_DAYS=7
# Minutes to wait for a buddy's reply before alerting the crew lead.
SHADEBREAK_CHECKIN_GRACE_MINUTES=15
# Address lookup with the free U.S. Census geocoder ("census") or "" to turn off.
SHADEBREAK_GEOCODER=census

# --- Text messages --------------------------------------------------------------
# console (log only, default), twilio, gateway, or your own dotted path.
SHADEBREAK_SMS_BACKEND=messaging.backends.console.ConsoleBackend
# SHADEBREAK_SMS_BACKEND=messaging.backends.twilio.TwilioBackend
# SHADEBREAK_SMS_BACKEND=messaging.backends.gateway.GatewayBackend
SHADEBREAK_SMS_FROM=+16025550000
# Replace á, í, ó, ú and ° so Spanish texts stay in cheap 160-character segments.
SHADEBREAK_SMS_FOLD_ACCENTS=1

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Generic HTTP gateway (outbound) and its inbound webhook token
SHADEBREAK_SMS_GATEWAY_URL=
SHADEBREAK_SMS_GATEWAY_TOKEN=
SHADEBREAK_SMS_INBOUND_TOKEN=
